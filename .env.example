# browser-use — enterprise hardening defaults.
# Copy to `.env` OR export these before the FIRST `browser-use` call.
# IMPORTANT: these must be set BEFORE the process starts — browser-use reads
# telemetry settings once at import time; setting them late has no effect.

# --- Information security: kill every phone-home / cloud path ---
ANONYMIZED_TELEMETRY=false      # disable PostHog analytics
BROWSER_USE_CLOUD_SYNC=false    # never sync profiles/cookies to the cloud
BROWSER_USE_VERSION_CHECK=false # no "new version available" phone-home
# BROWSER_USE_API_KEY   -> leave UNSET. Setting it enables cloud features.

# No Playwright / browser download is used. Chromium attaches through CDP;
# Firefox uses the installed geckodriver. Override discovery only if needed:
# GECKODRIVER=/path/to/geckodriver
# FIREFOX_BINARY=/path/to/firefox
# FIREFOX_PROFILES_INI=/path/to/profiles.ini
# FIREFOX_PROFILE_HOME=/path/to/firefox-automation-profiles
# FIREFOX_STATE_HOME=/path/to/firefox-automation-state
# FIREFOX_USE_HEADLESS=false
